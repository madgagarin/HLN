{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/madgagarin/HLN/main/schemas/blob_reference.schema.json",
  "title": "BlobReference",
  "description": "Content-addressed reference to large binary payloads offloaded to CAS or object storage",
  "type": "object",
  "required": ["uri", "digest", "size_bytes"],
  "properties": {
    "uri": {
      "type": "string",
      "description": "Storage URI (e.g. s3://bucket/key, cas://sha256/...)"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 cryptographic digest of the payload"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Exact size of the uncompressed blob in bytes"
    },
    "media_type": {
      "type": "string",
      "default": "application/octet-stream",
      "description": "MIME type of the referenced binary"
    },
    "etag": {
      "type": ["string", "null"],
      "description": "Optional HTTP/S3 entity tag"
    }
  },
  "additionalProperties": false
}
