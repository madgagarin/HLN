{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/madgagarin/HLN/main/schemas/canonical_manifest.schema.json",
  "title": "CanonicalManifest",
  "description": "Canonical representation of a published skill or blueprint release",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "name",
    "version",
    "contract_digest",
    "input_schema",
    "output_schema",
    "impl_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": ["skill", "blueprint"]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)?$",
      "maxLength": 192
    },
    "version": {
      "type": "string",
      "description": "SemVer 2.0.0 release version"
    },
    "parent_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author": {
      "type": "string"
    },
    "commit_message": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mode": {
      "type": "string",
      "enum": ["portable", "blackbox"],
      "default": "portable"
    },
    "runtime_constraint": {
      "type": "string"
    },
    "driver": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string"
    },
    "driver_config": {
      "type": "object"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "config": {
      "type": "object",
      "properties": {
        "required_secrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_env": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "low"
    },
    "impl_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "env_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu_cores": { "type": "number", "minimum": 0 },
        "min_ram_mb": { "type": "integer", "minimum": 0 },
        "min_vram_mb": { "type": "integer", "minimum": 0 }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["digest", "size_bytes", "mount_path"],
        "properties": {
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "mount_path": { "type": "string" }
        }
      }
    },
    "topology": {
      "type": ["object", "null"]
    },
    "resolved_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "manifest_digest"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  },
  "additionalProperties": false
}
